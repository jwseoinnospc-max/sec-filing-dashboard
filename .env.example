# Copy this file to .env.local and fill in your own keys.
# Sign up for free at https://finnhub.io and https://site.financialmodelingprep.com/developer
# Used by the Space Market page (app/space-market/page.tsx) to show company profile, market cap, and P/E.
FINNHUB_API_KEY=
FMP_API_KEY=

# Optional: TheSpaceDevs Launch Library 2 API token (raises the free 15 req/hour limit).
# Used by the Launch Schedule page (app/schedule + app/api/launches). Leave blank to use the free tier.
SPACEDEVS_TOKEN=
